{% extends "basegame.html.twig" %}

{% block title %}Spela 21{% endblock %}

{% block body %}
    <h1>Spela 21</h1>

    <div class="game-layout">

        {% if (gamephase == 'playersturn') %}
            {% if (loss == true) %}
                <div class="game-header-one-button">
                    <a href="{{ path('game_init') }}"><button class="game-button">Spela igen</button></a>
                    <div class="sum-style">{{ outcome }}</div>
            {% else %}
                <div class="game-header-two-button">
                    <a href="{{ path('game_drawcard') }}"><button class="game-button">Dra ett kort</button></a>
                    <a href="{{ path('game_pass') }}"><button class="game-button">Stanna</button></a>
            {% endif %}
                    <div class="points">
                        <div class="subpoints-cat">Dina poäng:</div>
                        <div class="subpoints"> {{ playerpoints }}</div>
                        <div class="subpoints-cat">Bankens poäng:</div>
                        <div class="subpoints"> {{ bankpoints }}</div>
                    </div>
                </div>
                <div class="board-header">
                    <div class="sum-style">
                        Din summa: {{ playersum }}
                    </div>
                </div>
                <div class="board-main">
                    <div class="cardcontainer">
                        {% for value in playerdrawncards %}
                            {% if (value[-1:] == '♥') or (value[-1:] == '♦') %}
                                <div class="singlecardcontainerred">
                            {% else %}
                                <div class="singlecardcontainerblack">
                            {% endif %}
                                <div class="singlecardborder">
                                    <div class="upperleftrank">
                                        {% if value|length == 2 %}
                                        {{ value|slice(0, 1) }}
                                        {% else %}
                                        {{ value|slice(0, 2) }}
                                        {% endif %}
                                    </div>
                                    <div class="upperleftsuit">
                                        {{ value[-1:] }}
                                    </div>
                                    <br>
                                    <div class="lowerrightsuit">
                                        {{ value[-1:] }}
                                    </div>
                                    <div class="lowerrightrank">
                                        {% if value|length == 2 %}
                                        {{ value|slice(0, 1) }}
                                        {% else %}
                                        {{ value|slice(0, 2) }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
        {% endif %}

        {% if (gamephase == 'banksturn') %}
            <div class="game-header-one-button">
            {% if (loss == true) %}
                <a href="{{ path('game_init') }}"><button class="game-button">Spela igen</button></a>
                <span class="sum-style">{{ outcome }}</span>
            {% else %}
                {% if (banksum > 16 and banksum < 22) %}
                    <a href="{{ path('game_pass') }}"><button class="game-button">Nästa</button></a>
                {% else %}
                    <a href="{{ path('game_drawcard') }}"><button class="game-button">Nästa</button></a>
                {% endif %}
            {% endif %}
                <div class="points">
                    <div class="subpoints-cat">Dina poäng:</div>
                    <div class="subpoints"> {{ playerpoints }}</div>
                    <div class="subpoints-cat">Bankens poäng:</div>
                    <div class="subpoints"> {{ bankpoints }}</div>
                </div>
            </div>
            <div class="board-header">
                <div class="sum-style">Bankens summa: {{ banksum }}</div>
                <div class="sum-style">Din summa: {{ playersum }}</div>
            </div>
            <div class="board-main-two-col">
                <div class="card-container-two-col">
                {% for value in bankdrawncards %}
                    {% if (value[-1:] == '♥') or (value[-1:] == '♦') %}
                        <div class="singlecardcontainerred">
                    {% else %}
                        <div class="singlecardcontainerblack">
                    {% endif %}
                        <div class="singlecardborder">
                            <div class="upperleftrank">
                                {% if value|length == 2 %}
                                {{ value|slice(0, 1) }}
                                {% else %}
                                {{ value|slice(0, 2) }}
                                {% endif %}
                            </div>
                            <div class="upperleftsuit">
                                {{ value[-1:] }}
                            </div>
                            <br>
                            <div class="lowerrightsuit">
                                {{ value[-1:] }}
                            </div>
                            <div class="lowerrightrank">
                                {% if value|length == 2 %}
                                {{ value|slice(0, 1) }}
                                {% else %}
                                {{ value|slice(0, 2) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
                </div>

                <div class="card-container-two-col">
                {% for value in playerdrawncards %}
                    {% if (value[-1:] == '♥') or (value[-1:] == '♦') %}
                        <div class="singlecardcontainerred">
                    {% else %}
                        <div class="singlecardcontainerblack">
                    {% endif %}
                        <div class="singlecardborder">
                            <div class="upperleftrank">
                                {% if value|length == 2 %}
                                {{ value|slice(0, 1) }}
                                {% else %}
                                {{ value|slice(0, 2) }}
                                {% endif %}
                            </div>
                            <div class="upperleftsuit">
                                {{ value[-1:] }}
                            </div>
                            <br>
                            <div class="lowerrightsuit">
                                {{ value[-1:] }}
                            </div>
                            <div class="lowerrightrank">
                                {% if value|length == 2 %}
                                {{ value|slice(0, 1) }}
                                {% else %}
                                {{ value|slice(0, 2) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if (gamephase == 'decide') %}
            <div class="game-header-one-button">
                <a href="{{ path('game_init') }}"><button class="game-button">Spela igen</button></a>
                <div class="sum-style">{{ outcome }}</div>
                <div class="points">
                    <div class="subpoints-cat">Dina poäng:</div>
                    <div class="subpoints"> {{ playerpoints }}</div>
                    <div class="subpoints-cat">Bankens poäng:</div>
                    <div class="subpoints"> {{ bankpoints }}</div>
                </div>
            </div>

            <div class="board-header">
                {% if (winner == 'bank') %}
                    <div class="sum-style winner-style">Bankens summa: {{ banksum }} </div>
                    <div class="player-sum-decide-phase looser-style">Din summa: {{ playersum }}</div>
                {% else %}
                    <div class="sum-style looser-style">Bankens summa: {{ banksum }} </div>
                    <div class="player-sum-decide-phase winner-style">Din summa: {{ playersum }}</div>
                {% endif %}
            </div>
            <div class="board-main-two-col">
                <div class="card-container-two-col">
                    {% for value in bankdrawncards %}
                        {% if (value[-1:] == '♥') or (value[-1:] == '♦') %}
                            <div class="singlecardcontainerred">
                        {% else %}
                            <div class="singlecardcontainerblack">
                        {% endif %}
                            <div class="singlecardborder">
                                <div class="upperleftrank">
                                    {% if value|length == 2 %}
                                    {{ value|slice(0, 1) }}
                                    {% else %}
                                    {{ value|slice(0, 2) }}
                                    {% endif %}
                                </div>
                                <div class="upperleftsuit">
                                    {{ value[-1:] }}
                                </div>
                                <br>
                                <div class="lowerrightsuit">
                                    {{ value[-1:] }}
                                </div>
                                <div class="lowerrightrank">
                                    {% if value|length == 2 %}
                                    {{ value|slice(0, 1) }}
                                    {% else %}
                                    {{ value|slice(0, 2) }}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="card-container-two-col">
                    {% for value in playerdrawncards %}
                        {% if (value[-1:] == '♥') or (value[-1:] == '♦') %}
                            <div class="singlecardcontainerred">
                        {% else %}
                            <div class="singlecardcontainerblack">
                        {% endif %}
                            <div class="singlecardborder">
                                <div class="upperleftrank">
                                    {% if value|length == 2 %}
                                    {{ value|slice(0, 1) }}
                                    {% else %}
                                    {{ value|slice(0, 2) }}
                                    {% endif %}
                                </div>
                                <div class="upperleftsuit">
                                    {{ value[-1:] }}
                                </div>
                                <br>
                                <div class="lowerrightsuit">
                                    {{ value[-1:] }}
                                </div>
                                <div class="lowerrightrank">
                                    {% if value|length == 2 %}
                                    {{ value|slice(0, 1) }}
                                    {% else %}
                                    {{ value|slice(0, 2) }}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
        {% endif %}
            </div>
        </div>
    </div>



{% endblock %}